root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown keeps trailing whitespace meaningful (two spaces are a hard line break).
[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 4

# Generated or externally formatted files that are not ours to restyle.
[{pnpm-lock.yaml,*.lock,mise.lock}]
indent_size = unset
insert_final_newline = unset
