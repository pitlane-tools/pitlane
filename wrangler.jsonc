{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "pitlane",
    "account_id": "3e1fe2693d3175f5f65ef46352f4f747",
    "compatibility_date": "2026-04-26",
    // pitlane.tools is attached as a custom domain on the Cloudflare side; it
    // stays out of this config because CI's API token is scoped to Workers
    // only (no zone permissions), and custom domains persist across deploys.
    "preview_urls": true,
    // worker.ts canonicalizes trailing-slash URLs and serves the prerendered
    // 404 page on misses; assets that match are served without invoking it.
    "main": "worker.ts",
    "assets": {
        "directory": "./docs/.vitepress/dist",
        "binding": "ASSETS",
        "not_found_handling": "none"
    }
}
