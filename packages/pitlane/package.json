{
    "name": "pitlane",
    "version": "1.0.0-alpha.2",
    "description": "A composable toolkit for Remix: build tooling, runtime packages, and provider integrations.",
    "keywords": [
        "pitlane",
        "remix",
        "vite"
    ],
    "homepage": "https://pitlane.tools",
    "bugs": {
        "url": "https://github.com/pitlane-tools/pitlane/issues"
    },
    "license": "MIT",
    "author": "Mark Malstrom <mark@malstrom.me>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pitlane-tools/pitlane.git",
        "directory": "packages/pitlane"
    },
    "files": [
        "dist",
        "guides",
        "INDEX.md",
        "CHANGELOG.md"
    ],
    "type": "module",
    "exports": {
        "./assets": {
            "types": "./dist/assets.d.mts",
            "import": "./dist/assets.mjs"
        },
        "./assets/build": {
            "types": "./dist/assets/build.d.mts",
            "import": "./dist/assets/build.mjs"
        },
        "./assets/manifest": {
            "types": "./dist/assets/manifest.d.mts",
            "import": "./dist/assets/manifest.mjs"
        },
        "./assets/vite-plugin": {
            "types": "./dist/assets/vite-plugin.d.mts",
            "import": "./dist/assets/vite-plugin.mjs"
        },
        "./content": {
            "types": "./dist/content.d.mts",
            "import": "./dist/content.mjs"
        },
        "./content/hot": {
            "types": "./dist/content/hot.d.mts",
            "import": "./dist/content/hot.mjs"
        },
        "./content/loaders": {
            "types": "./dist/content/loaders.d.mts",
            "import": "./dist/content/loaders.mjs"
        },
        "./content/satteri": {
            "types": "./dist/content/satteri.d.mts",
            "import": "./dist/content/satteri.mjs"
        },
        "./content/vite-plugin": {
            "types": "./dist/content/vite-plugin.d.mts",
            "import": "./dist/content/vite-plugin.mjs"
        },
        "./crawler": {
            "types": "./dist/crawler.d.mts",
            "import": "./dist/crawler.mjs"
        },
        "./data-table-d1": {
            "types": "./dist/data-table-d1.d.mts",
            "import": "./dist/data-table-d1.mjs"
        },
        "./data-table-d1/migrations": {
            "types": "./dist/data-table-d1/migrations.d.mts",
            "import": "./dist/data-table-d1/migrations.mjs"
        },
        "./theme": {
            "types": "./dist/theme.d.mts",
            "import": "./dist/theme.mjs"
        },
        "./theme/default": {
            "types": "./dist/theme/default.d.mts",
            "import": "./dist/theme/default.mjs"
        },
        "./theme/dtcg": {
            "types": "./dist/theme/dtcg.d.mts",
            "import": "./dist/theme/dtcg.mjs"
        },
        "./theme/schema": {
            "types": "./dist/theme/schema.d.mts",
            "import": "./dist/theme/schema.mjs"
        },
        "./vite-plugin-fetch-server": {
            "types": "./dist/vite-plugin-fetch-server.d.mts",
            "import": "./dist/vite-plugin-fetch-server.mjs"
        },
        "./vite-plugin-remix": {
            "types": "./dist/vite-plugin-remix.d.mts",
            "import": "./dist/vite-plugin-remix.mjs"
        },
        "./vite-plugin-remix/hmr": {
            "types": "./dist/vite-plugin-remix/hmr.d.mts",
            "import": "./dist/vite-plugin-remix/hmr.mjs"
        }
    },
    "scripts": {
        "prepublishOnly": "vp run build"
    },
    "dependencies": {
        "@pitlane/assets": "workspace:*",
        "@pitlane/content": "workspace:*",
        "@pitlane/crawler": "workspace:*",
        "@pitlane/data-table-d1": "workspace:*",
        "@pitlane/theme": "workspace:*",
        "@pitlane/vite-plugin-fetch-server": "workspace:*",
        "@pitlane/vite-plugin-remix": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^25.5.0",
        "@types/semver": "^7.7.1",
        "remix": "3.0.0",
        "satteri": "^0.10.5",
        "semver": "^7.8.5",
        "typescript": "^7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@^1.0.0",
        "vite-plus": "^1.0.0"
    },
    "peerDependencies": {
        "remix": "^3.0.0",
        "satteri": "^0.10.5",
        "vite": ">=8.1.0"
    },
    "peerDependenciesMeta": {
        "satteri": {
            "optional": true
        }
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    }
}
