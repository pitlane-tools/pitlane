{
    "compilerOptions": {
        "target": "ESNext",
        "lib": ["ESNext", "DOM"],
        "moduleDetection": "force",
        "module": "Preserve",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "strict": true,
        "noUnusedLocals": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["src", "tests"]
}
