{
    "compilerOptions": {
        "target": "esnext",
        "lib": ["esnext", "dom"],
        "moduleDetection": "force",
        "module": "preserve",
        "moduleResolution": "bundler",
        "strict": true,
        "noUnusedLocals": true,
        "declaration": true,
        "allowImportingTsExtensions": true,
        "emitDeclarationOnly": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["src", "tests/*.test.ts"],
    // Components an MDX fixture imports at runtime. Nothing imports them as
    // modules, and `clientEntry`'s inferred type cannot be named from here.
    "exclude": ["src/fixtures"]
}
