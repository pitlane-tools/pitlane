{
    "$schema": "https://typedoc.org/schema.json",
    "extends": "./typedoc.base.json",
    "entryPoints": ["packages/theme/src/index.ts"],
    "tsconfig": "packages/theme/tsconfig.json",
    "out": "docs/package/theme",
    "entryModule": "@pitlane/theme",
    // Internal aliases that appear in public signatures. They are inlined into
    // the emitted .d.ts rather than exported, and the accepted-values table on
    // ThemedCSSProps is the reference for what they stand for.
    "intentionallyNotExported": [
        "ColorLike",
        "Wide",
        "Size",
        "SizeAuto",
        "SizeIntrinsic",
        "SpacingText",
        "LineWidth",
        "Easing",
        "ShadowLike",
        "Numeric",
        "Repeat1to4",
        "PadItem",
        "MarginItem",
        "GroupType",
        "TOKEN_TYPES",
        "Selection",
        "VariantShape",
        "CombinedProps",
        "BrandByType",
        "TokenGroup",
        "TreeOf",
        "RemixCSSProps"
    ]
}
