{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "jsxImportSource": "@remix-run/ui",
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "strict": true,
        "skipLibCheck": true,
        "types": ["@types/node"]
    },
    "include": ["**/*.ts", "**/*.tsx"]
}
