{
    "$schema": "https://typedoc.org/schema.json",
    "extends": "./base.json",
    "entryPoints": [
        "../packages/theme/src/index.ts",
        "../packages/theme/src/schema.ts",
        "../packages/theme/src/default.ts",
        "../packages/theme/src/dtcg.ts"
    ],
    "tsconfig": "../packages/theme/tsconfig.json",
    "out": "../docs/app/content/api/theme",
    "entryModule": "@pitlane/theme",
    // ThemedCSSProps inherits one member per csstype property through
    // KeywordProps. Its description and accepted-values table state what they
    // take, so the page counts them rather than listing several hundred.
    "summarizeInheritedFrom": ["KeywordProps"],
    // Internal aliases that appear in public signatures. They are inlined into
    // the emitted .d.ts rather than exported, and the accepted-values table on
    // ThemedCSSProps is the reference for what they stand for. DefaultThemeInit
    // is the whole Tailwind token tree; DefaultTheme's summary names its groups.
    // ExtendPatch is the exactly typed ThemePatch, which extend's docs link.
    "intentionallyNotExported": [
        "DefaultThemeInit",
        "ExtendPatch",
        "ColorLike",
        "Wide",
        "Size",
        "SizeAuto",
        "SizeIntrinsic",
        "SpacingText",
        "LineWidth",
        "Easing",
        "ShadowLike",
        "Numeric",
        "Repeat1to4",
        "PadItem",
        "MarginItem",
        "TOKEN_TYPES",
        "Selection",
        "VariantShape",
        "CombinedProps",
        "BrandByType",
        "TreeOf",
        "RemixCSSProps"
    ]
}
