{
    "$schema": "https://typedoc.org/schema.json",
    "extends": "./base.json",
    "entryPoints": [
        "../packages/content/src/index.ts",
        "../packages/content/src/loaders.ts",
        "../packages/content/src/satteri.ts",
        "../packages/content/src/vite-plugin.ts",
        "../packages/content/src/hot.ts"
    ],
    "tsconfig": "../packages/content/tsconfig.json",
    "out": "../docs/app/content/api/content",
    "entryModule": "@pitlane/content",
    // Standard Schema v1 is declared in types.ts rather than depended on, and
    // it appears in every collection signature through inference. Its
    // specification is the reference for it.
    "externalSymbolLinkMappings": {
        "@pitlane/content": { "StandardSchemaV1": "https://standardschema.dev" }
    },
    // What ReferenceSchema is built from. Its `pipe` and `refine` exist for the
    // combinators' sake and do nothing on a reference, so ReferenceSchema's own
    // summary describes what it is instead.
    // InferSchema is the output type a schema produces, which Content's
    // summary states in words.
    "intentionallyNotExported": ["ChainableSchema", "InferSchema"]
}
