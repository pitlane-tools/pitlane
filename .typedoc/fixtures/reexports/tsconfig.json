{
    "compilerOptions": {
        "target": "esnext",
        "lib": ["esnext"],
        "moduleDetection": "force",
        "module": "preserve",
        "moduleResolution": "bundler",
        "strict": true,
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true
    },
    "include": ["src"]
}
