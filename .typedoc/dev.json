{
    "$schema": "https://typedoc.org/schema.json",
    "extends": "./base.json",
    "entryPoints": [
        "../packages/dev/src/index.ts",
        "../packages/dev/src/runtime.ts",
        "../packages/dev/src/assets.d.ts"
    ],
    "tsconfig": "../packages/dev/tsconfig.json",
    "out": "../docs/app/content/api/dev",
    "entryModule": "@pitlane/dev",
    // assets.d.ts names ImportedAssets through an inline import of the
    // package's own built runtime, which TypeDoc sees as a different symbol.
    "externalSymbolLinkMappings": {
        "@pitlane/dev": { "ImportedAssets": "/package/dev/runtime/interface/ImportedAssets" }
    }
}
