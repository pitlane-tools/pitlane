{
    "$schema": "https://typedoc.org/schema.json",
    "plugin": ["typedoc-plugin-markdown", "./plugin.mjs"],
    "theme": "pitlane",
    "router": "pitlane",
    "skipErrorChecking": true,
    "cleanOutputDir": true,
    "readme": "none",
    "githubPages": false,
    "excludeInternal": true,
    "disableSources": true,
    "outputFileStrategy": "modules",
    "entryFileName": "index.md",
    "hidePageHeader": true,
    "hideBreadcrumbs": true,
    "useCodeBlocks": true,
    "formatWithPrettier": false
}
