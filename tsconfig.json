{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "noEmit": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2022",
        "types": ["node"],
        "verbatimModuleSyntax": true
    },
    "exclude": ["packages/mdx-checker/*.d.ts", "node_modules"],
    "include": [
        "vite.config.ts",
        ".omp/hooks/*.ts",
        ".omp/tools/**/*.ts",
        "tools/**/*.ts",
        "packages/mdx-checker/*.ts"
    ]
}
