{
    "name": "pitlane-docs",
    "private": true,
    "type": "module",
    "scripts": {
        "docs:api": "typedoc",
        "docs:dev": "typedoc && vitepress dev docs --port 1337",
        "docs:build": "typedoc && vitepress build docs",
        "docs:serve": "vitepress serve docs --port 1337"
    },
    "devDependencies": {
        "@voidzero-dev/vitepress-theme": "latest",
        "shiki": "^4.0.2",
        "typedoc": "^0.28.20",
        "typedoc-plugin-markdown": "^4.12.0",
        "typescript": "^5.9",
        "vite-plus": "^0.2.6",
        "vitepress": "latest",
        "vitepress-plugin-group-icons": "latest",
        "vue": "latest",
        "wrangler": "^4.85.0"
    },
    "packageManager": "pnpm@11.17.0"
}
